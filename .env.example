# Backend
ENVIRONMENT=development
LOG_LEVEL=INFO
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=career-coach-api
JWT_AUDIENCE=career-coach-web
CORS_ORIGINS=http://localhost:5173
AUTO_CREATE_SCHEMA=true
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# MySQL / Redis（先执行 docker compose up -d）
MYSQL_DATABASE=career_coach
MYSQL_USER=career
MYSQL_PASSWORD=career_dev_password
MYSQL_ROOT_PASSWORD=root_dev_password
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MYSQL_PORT=3308
DATABASE_URL=mysql+asyncmy://career:career_dev_password@localhost:3308/career_coach?charset=utf8mb4
REDIS_ENABLED=true
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0
REDIS_PASSWORD=

# Milvus；桌面 Attu 连接 http://localhost:19530。
MILVUS_ENABLED=true
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=root:Milvus
MILVUS_COLLECTION=communication_knowledge

# Frontend
VITE_API_BASE_URL=/api/v1

